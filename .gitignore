# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   For an app, this contains the version of python used to build/run the app.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library, you should ignore it:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be submitted unless you want to ignore it:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be submitted unless you want to ignore it:
#.pdm.toml
#.pdm-plugins/
#pdm.lock

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

